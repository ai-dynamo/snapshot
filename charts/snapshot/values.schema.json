{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nSPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "properties": {
    "storage": {
      "type": "object",
      "properties": {
        "pvc": {
          "type": "object",
          "properties": {
            "nfsReadAheadKiB": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            }
          }
        }
      }
    },
    "pageBroker": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "transferBufferCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "transferChunkBytes": {
          "type": "integer",
          "minimum": 4096,
          "multipleOf": 4096,
          "maximum": 9223372036854775807
        },
        "maxPinnedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        }
      }
    }
  }
}
