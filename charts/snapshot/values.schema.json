{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nSPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "checkpoint": {
          "type": "object",
          "properties": {
            "retryLimit": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "coordinator": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "healthPort": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "maxMemoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tls": {
          "type": "object",
          "properties": {
            "serving": {
              "type": "object",
              "properties": {
                "secretName": {
                  "type": "string"
                }
              }
            },
            "trust": {
              "type": "object",
              "properties": {
                "configMapName": {
                  "type": "string"
                },
                "secretName": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "if": {
                "required": ["configMapName"],
                "properties": {
                  "configMapName": {
                    "minLength": 1
                  }
                }
              },
              "then": {
                "properties": {
                  "secretName": {
                    "maxLength": 0
                  }
                }
              }
            },
            "serverName": {
              "type": "string"
            }
          }
        }
      }
    },
    "pageBroker": {
      "type": "object",
      "properties": {
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "transferBufferCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "transferChunkBytes": {
          "type": "integer",
          "minimum": 4096,
          "multipleOf": 4096,
          "maximum": 9223372036854775807
        },
        "maxPinnedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "s3": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "transferEngine": {
          "type": "object",
          "properties": {
            "modelStreamer": {
              "type": "object"
            }
          }
        }
      }
    },
    "podGroups": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
