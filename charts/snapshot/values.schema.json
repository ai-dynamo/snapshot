{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "SPDX-FileCopyrightText: Copyright (c) 2026 NVIDIA CORPORATION & AFFILIATES. All rights reserved.\nSPDX-License-Identifier: Apache-2.0",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "checkpoint": {
          "type": "object",
          "properties": {
            "retryLimit": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "pageBroker": {
      "type": "object",
      "properties": {
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "stagingBytesPerGPU": {
          "type": "integer",
          "minimum": 134217728,
          "multipleOf": 134217728,
          "maximum": 9223372036854775807
        },
        "s3": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        "transferEngine": {
          "type": "object",
          "properties": {
            "modelStreamer": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
