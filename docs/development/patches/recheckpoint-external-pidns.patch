diff --git a/agent/internal/runtime/namespaces.go b/agent/internal/runtime/namespaces.go
--- a/agent/internal/runtime/namespaces.go
+++ b/agent/internal/runtime/namespaces.go
@@ -20,0 +21,10 @@
+
+// GetPIDNSInode returns the selected workload's PID namespace inode via /host/proc.
+func GetPIDNSInode(pid int) (uint64, error) {
+	nsPath := fmt.Sprintf("%s/%d/ns/pid", HostProcPath, pid)
+	var stat unix.Stat_t
+	if err := unix.Stat(nsPath, &stat); err != nil {
+		return 0, fmt.Errorf("failed to stat %s: %w", nsPath, err)
+	}
+	return stat.Ino, nil
+}
