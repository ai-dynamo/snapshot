flowchart TB
    Owner["Workload owner"]
    Grove["Grove or another workload manager"]
    Pods["Source and target Pods"]
    Group["Snapshot group controller"]
    Capture["PodGroupSnapshot"]
    Content["PodGroupSnapshotContent"]
    Restore["PodGroupRestore"]
    Leaf0["Existing per-Pod path - rank 0"]
