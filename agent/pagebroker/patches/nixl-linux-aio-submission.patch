Complete failed Linux AIO submissions without losing pool entries or reporting
request failure before the remaining callbacks drain. Applied to NIXL revision
71ca3cb249a481ae892fcc042a456e1a9b87463d.

--- a/src/plugins/posix/linux_aio_io_queue.cpp
+++ b/src/plugins/posix/linux_aio_io_queue.cpp
@@ -126,7 +126,16 @@
             ret = 0; // 0 were submitted, we will try again later
         } else {
             NIXL_ERROR << "io_submit failed: " << nixl_strerror(-ret);
-            return NIXL_ERR_BACKEND;
+            // A negative result submitted nothing. Complete the first failed
+            // entry and retry the remaining entries through the normal queue.
+            // Returning an error here could release a request whose other I/Os
+            // still have callbacks queued or in flight.
+            auto *failed = to_submit[0];
+            if (failed->clb_) {
+                failed->clb_(failed->ctx_, 0, 1);
+            }
+            free_ios_.push_back(failed);
+            ret = 1;
         }
     }
 
