# Local E2E overlay. The named context contains binaries built from the checked-out
# Snapshot and CRIU branches; production builds continue to use Dockerfile.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
COPY --from=pagebroker-build /snapshot-agent /usr/local/bin/snapshot-agent
COPY --from=pagebroker-build /nsrestore /usr/local/bin/nsrestore
COPY --from=pagebroker-build /pagebroker-packager /usr/local/bin/pagebroker-packager
COPY --from=pagebroker-build /pagebroker /usr/local/bin/pagebroker
COPY --from=pagebroker-build /criu /usr/local/sbin/criu
RUN chmod +x /usr/local/bin/snapshot-agent /usr/local/bin/nsrestore /usr/local/bin/pagebroker-packager /usr/local/bin/pagebroker /usr/local/sbin/criu
